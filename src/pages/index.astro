---
import BaseLayout from "../layouts/BaseLayout.astro"
import '../styles/global.css'
const allPost = Object.values(import.meta.glob('./posts/*.md', { eager: true }))
---

<BaseLayout>
    <section class="max-w-4xl mx-auto p-8">
        <h2 class="text-3xl text-[] font-bold mb-4">Bienvenido a mi Manual Técnico de Astro</h2>

        <div class="bg-[#00415a]  rounded-xl p-3">
		<p class="text-white">Este sitio web tiene como objetivo servir como un manual de referencia para aprender los sobre Astro y Tailwind.</p>
		</div>
    </section>
	
	{allPost.map((post: any) => (
    <a href={post.url} class="block m-4 bg-[#00708f] p-4 rounded-tl-3xl rounded-br-3xl border-8 border-[#00a6af] hover:opacity-80">
    <h2 class="text-2xl font-bold">{post.frontmatter.title}</h2>
    <p>{post.frontmatter.description}</p>
    </a>
		))}
</Layout>
</BaseLayout>